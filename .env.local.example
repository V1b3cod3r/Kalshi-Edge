# Kalshi Edge — Environment Variables
# Copy this file to .env.local and fill in your values
# Note: API keys can also be configured via the Settings page in the UI
# and will be stored in data/settings.json

NEXT_PUBLIC_APP_NAME=Kalshi Edge

# Optional: Override API keys via environment variables instead of the UI
# ANTHROPIC_API_KEY=sk-ant-...
# KALSHI_API_KEY=...

# Required before deploying anywhere public (e.g. Railway): gates every page
# and API route behind HTTP Basic Auth. Without these two set, the app is
# wide open — anyone with the URL could flip autopilot to live mode, raise
# spend limits, or place real orders using your Kalshi keys.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
